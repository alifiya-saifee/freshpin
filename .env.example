# Copy to .env and fill in. Nothing else to install: FreshPin uses only the Python standard library.

# live = Bifrost + Tavily.  replay = recorded responses for offline tests.
FRESHPIN_MODE=live

# Tavily (free credits at app.tavily.com)
TAVILY_API_KEY=tvly-...

# Bifrost gateway. Start it with:  npx -y @maximhq/bifrost   then add provider keys at http://localhost:8080
BIFROST_URL=http://localhost:8080
# Bifrost virtual key (sk-bf-...). Needed when Bifrost enforces virtual keys (the v2.5 default after admin setup).
# Create it under Governance > Virtual Keys and allow your providers AND models. Gives gateway-side budgets and rate limits.
BIFROST_VIRTUAL_KEY=

# Bifrost "provider/model" names. First = primary, the rest = fallbacks.
# Use models you have enabled in Bifrost. Mixing two providers gives real failover.
# Defaults: Gemini and Groq, both with free tiers (worked on 15 Nov 2026; providers retire models, so check Bifrost's list).
# Tested setup (15 Nov 2026): NVIDIA build models through Bifrost's OpenAI provider (Base URL
# https://integrate.api.nvidia.com, key nvapi-...), so their names start with "openai/".
#   FRESHPIN_EXTRACTOR_MODELS=openai/nvidia/nemotron-3.5-lightning-30b-a3b,openai/nvidia/nemotron-3.5-super-vl-120b-a12b,gemini/gemini-3.5-flash-lite
#   FRESHPIN_VERIFIER_MODELS=openai/nvidia/nemotron-3.5-super-vl-120b-a12b,openai/mistralai/mistral-large-4-1t-a52b,gemini/gemini-3.5-flash-lite
#   FRESHPIN_CHECKER_MODELS=groq/openai/gpt-oss-120b,openai/mistralai/mistral-large-4-1t-a52b,gemini/gemini-3.5-flash-lite
#   FRESHPIN_NO_THINKING_PREFIXES=openai/
# Without NVIDIA, Gemini + Groq alone also work, within their small free limits:
FRESHPIN_EXTRACTOR_MODELS=gemini/gemini-3.5-flash-lite,groq/openai/gpt-oss-120b
FRESHPIN_VERIFIER_MODELS=groq/openai/gpt-oss-120b,gemini/gemini-3.5-flash-lite
# Recheck layer: the second, independent judge. Use a different primary provider from the verifier.
FRESHPIN_CHECKER_MODELS=gemini/gemini-3.5-flash-lite,groq/openai/gpt-oss-120b
# Providers whose models run with "thinking off" (comma-separated "provider/" prefixes). NVIDIA accepts it;
# Gemini and Groq reject it, so leave them out. Empty = never send it.
FRESHPIN_NO_THINKING_PREFIXES=
# Model calls at the same time (free tiers limit tokens per minute).
FRESHPIN_MODEL_CONCURRENCY=2
# 1 = recheck every claim (one extra Tavily search + one model call per claim). 0 = off.
FRESHPIN_RECHECK=1
# A model name that will fail, used by the "simulate outage" switch
FRESHPIN_OUTAGE_MODEL=groq/model-that-does-not-exist

FRESHPIN_RUN_TOKEN_BUDGET=60000
FRESHPIN_MAX_SOURCES=5
FRESHPIN_PORT=8787

# --- Running it for real (see README) ---
# Personal data (emails, phones, Emirates ID, IBAN, cards) is always masked before any search or model call.
# Model routes that are free or trial tiers (they may use your data to improve their products):
FRESHPIN_TRIAL_PREFIXES=
# 1 = customer data: refuse to run while any model is on a trial route above.
FRESHPIN_CUSTOMER_DATA=0
# Login for the JSON API and web app (every /api/ call except /api/status). Empty = no login (local demo only).
FRESHPIN_API_TOKEN=
# Spend cap: checks per day (0 = no cap).
FRESHPIN_DAILY_CHECK_LIMIT=0
# One changed fact reopens at most this many decisions automatically; the rest go "at risk".
FRESHPIN_MAX_AUTO_REOPENS=20
# Alerts (Slack-style webhook). Private/local addresses are blocked unless you allow them.
FRESHPIN_WEBHOOK_URL=
FRESHPIN_ALLOW_PRIVATE_WEBHOOK=0
