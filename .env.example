# Copy to .env and fill in. Nothing else to install: FreshPin uses only the Python standard library.

# live = Bifrost + Tavily.  replay = recorded responses for offline tests.
FRESHPIN_MODE=live

# Tavily (free credits at app.tavily.com)
TAVILY_API_KEY=tvly-...

# Bifrost gateway. Start it with:  npx -y @maximhq/bifrost   then add provider keys at http://localhost:8080
BIFROST_URL=http://localhost:8080
# Bifrost virtual key (sk-bf-...). Needed when Bifrost enforces virtual keys (the v2.5 default after admin setup).
# Create it under Governance > Virtual Keys and allow your providers AND models. Gives gateway-side budgets and rate limits.
BIFROST_VIRTUAL_KEY=

# Bifrost "provider/model" names. First = primary, the rest = fallbacks.
# Use models you have enabled in Bifrost. Mixing two providers gives real failover.
# Defaults: Gemini and Groq, both with free tiers (worked on 15 Nov 2026; providers retire models, so check Bifrost's list).
FRESHPIN_EXTRACTOR_MODELS=gemini/gemini-2.5-flash,groq/openai/gpt-oss-120b
FRESHPIN_VERIFIER_MODELS=groq/openai/gpt-oss-120b,gemini/gemini-2.5-flash
# A model name that will fail, used by the "simulate outage" switch
FRESHPIN_OUTAGE_MODEL=groq/model-that-does-not-exist

FRESHPIN_RUN_TOKEN_BUDGET=60000
FRESHPIN_MAX_SOURCES=5
FRESHPIN_PORT=8787
