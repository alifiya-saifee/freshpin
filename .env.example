# Copy to .env and fill in. Nothing else to install: FreshPin uses only the Python standard library.

# live = Bifrost + Tavily.  replay = recorded responses for offline tests.
FRESHPIN_MODE=live

# Tavily (free credits at app.tavily.com)
TAVILY_API_KEY=tvly-...

# Bifrost gateway. Start it with:  npx -y @maximhq/bifrost   then add provider keys at http://localhost:8080
BIFROST_URL=http://localhost:8080
# Optional: a Bifrost virtual key, for gateway-side budgets and rate limits
BIFROST_VIRTUAL_KEY=

# Bifrost "provider/model" names. First = primary, the rest = fallbacks.
# Use models you have enabled in Bifrost. Mixing two providers gives real failover.
FRESHPIN_EXTRACTOR_MODELS=openai/gpt-4o-mini,anthropic/claude-3-5-haiku-latest
FRESHPIN_VERIFIER_MODELS=anthropic/claude-3-5-haiku-latest,openai/gpt-4o-mini
# A model name that will fail, used by the "simulate outage" switch
FRESHPIN_OUTAGE_MODEL=openai/model-that-does-not-exist

FRESHPIN_RUN_TOKEN_BUDGET=60000
FRESHPIN_MAX_SOURCES=5
FRESHPIN_PORT=8787
